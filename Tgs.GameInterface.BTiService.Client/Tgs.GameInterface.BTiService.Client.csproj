<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<PropertyGroup>
		<Version>0.0.6</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameInterface BTi Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-btiservice</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-btiservice.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface BTiService</PackageTags>
	</PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.55.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.55.0" />
    <PackageReference Include="Grpc.Tools" Version="2.56.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Tgs.GameInterface.BTiService\Protos\gameinterfacebtiservice.proto" GrpcServices="Client">
      <Link>gameinterfacebtiservice.proto</Link>
    </Protobuf>
  </ItemGroup>

</Project>
